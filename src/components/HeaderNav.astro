---
import AccountNav from "./AccountNav";

interface Props {
	siteTitle: string;
	siteLogo?: { url?: string; alt?: string } | null;
	loginUrl: string;
}

const { siteTitle, siteLogo, loginUrl } = Astro.props;
---

<nav class="relative flex min-h-18 items-center gap-4" aria-label="Primary navigation">
	<a class="shrink-0 text-xl font-black tracking-[-.06em] no-underline" href="/">
		{siteLogo?.url ? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo" /> : siteTitle}
	</a>

	<div class="ml-auto font-bold">
		<AccountNav client:load loginUrl={loginUrl} />
	</div>
</nav>

<style>
	.site-logo { height: 48px; width: auto; margin: -8px 0; display: block; }
</style>
