---
import { getEmDashCollection, getSiteSettings, getTaxonomyTerms, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import RecipeFilters from "../components/RecipeFilters";
import Base from "../layouts/Base.astro";
import { hasRecipeLibraryAccess } from "../utils/recipe-library-auth";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const PAGE_SIZE = 50;
const values = (key: string) => [...new Set((Astro.url.searchParams.get(key) ?? "").split(",").filter(Boolean))];
const meal = Astro.url.searchParams.get("meal") ?? "";
const dietary = values("dietary");
const ingredient = values("ingredient");
const query = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();
const pageRequest = Math.max(1, Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const [{ entries: recipes, cacheHint }, mealTypes, dietaryTerms, settings] = await Promise.all([
	getEmDashCollection("recipes", { status: "published", limit: 2500, orderBy: { published_at: "desc" } }),
	getTaxonomyTerms("meal_type"), getTaxonomyTerms("dietary"), getSiteSettings(),
]);
Astro.cache.set(cacheHint);
const { entries: pdfRecipes, cacheHint: pdfCacheHint } = hasRecipeLibraryAccess(Astro.locals.user) ? await getEmDashCollection("recipe_pdfs", { status: "published", limit: 2500, orderBy: { recipe_date: "desc" } }) : { entries: [], cacheHint: undefined };
if (pdfCacheHint) Astro.cache.set(pdfCacheHint);
const dietaryByRecipe = await getTermsForEntries("recipes", recipes.map((recipe) => recipe.data.id), "dietary");
const mealsByRecipe = await getTermsForEntries("recipes", recipes.map((recipe) => recipe.data.id), "meal_type");
const ingredientText = (recipe: typeof recipes[number]) => {
	const collectText = (value: unknown): string[] => Array.isArray(value) ? value.flatMap(collectText) : value && typeof value === "object" ? Object.entries(value as Record<string, unknown>).flatMap(([key, item]) => key === "text" && typeof item === "string" ? [item] : collectText(item)) : [];
	return collectText(recipe.data.ingredients).join(" ").replaceAll(/\s+/g, " ").trim().toLowerCase();
};
const ingredientOptions = [...new Set(recipes.flatMap((recipe) => ingredientText(recipe).split(" ").filter((word) => word.length > 2)))].sort().slice(0, 250).map((word) => ({ value: word, label: word[0].toUpperCase() + word.slice(1) }));
const recipeItems = recipes.filter((recipe) => {
	const recipeDietary = (dietaryByRecipe.get(recipe.data.id) ?? []).map((term) => term.slug);
	const recipeMeals = (mealsByRecipe.get(recipe.data.id) ?? []).map((term) => term.slug);
	const ingredients = ingredientText(recipe);
	return (!meal || recipeMeals.includes(meal)) && dietary.every((term) => recipeDietary.includes(term)) && ingredient.every((term) => ingredients.includes(term)) && (!query || `${recipe.data.title} ${recipe.data.summary ?? ""} ${ingredients}`.toLowerCase().includes(query));
}).map((entry) => ({ type: "recipe" as const, entry }));
const pdfItems = pdfRecipes.filter((entry) => !meal && !dietary.length && !ingredient.length && (!query || `${entry.data.title} ${entry.data.source_filename}`.toLowerCase().includes(query))).map((entry) => ({ type: "pdf" as const, entry }));
const entries = [...recipeItems, ...pdfItems];
const totalPages = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
const page = Math.min(pageRequest, totalPages);
const visibleEntries = entries.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const pageUrl = (target: number) => { const params = new URLSearchParams(Astro.url.searchParams); target === 1 ? params.delete("page") : params.set("page", String(target)); return `/${params.size ? `?${params}` : ""}`; };
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);
---

<Base title={siteTitle} description={siteTagline}>
	<div class="mx-auto max-w-7xl px-4 pb-20 sm:px-8 lg:px-20">
		<section class="my-2 mb-12 flex min-h-80 items-center overflow-hidden rounded-3xl bg-[url('/images/recipe-hero.png')] bg-cover bg-center md:mb-20"><div class="max-w-xl bg-linear-to-r from-white/95 via-white/75 to-transparent p-8 sm:p-14"><span class="font-extrabold tracking-widest text-recipe-orange uppercase">Recipes for every day</span><h1 class="my-3 text-5xl leading-[.93] font-black tracking-[-.07em] sm:text-7xl">Cook something<br /><em class="not-italic text-recipe-orange">you’ll love.</em></h1><p class="text-lg text-zinc-600">Dependable recipes, gathered in one delicious place.</p></div></section>
		<section class="mx-auto max-w-6xl"><div class="flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-end"><div><span class="font-extrabold tracking-widest text-recipe-orange uppercase">Recipe finder</span><h2 class="my-2 text-3xl font-black tracking-[-.05em] sm:text-5xl">What are you in the mood for?</h2></div><p class="text-recipe-muted">{entries.length} {entries.length === 1 ? "recipe" : "recipes"} found</p></div>
			<RecipeFilters client:load mealTypes={mealTypes.map((term) => ({ value: term.slug, label: term.label }))} dietaryOptions={dietaryTerms.map((term) => ({ value: term.slug, label: term.label }))} ingredientOptions={ingredientOptions} initialMealType={meal} initialDietary={dietary} initialIngredients={ingredient} />
			{visibleEntries.length ? <ul class="grid grid-cols-1 gap-5 py-8 sm:grid-cols-2 lg:grid-cols-3">{visibleEntries.map((item) => item.type === "recipe" ? <li class="overflow-hidden rounded-2xl bg-white shadow-[0_4px_18px_rgb(26_22_15_/_0.05)]"><a class="block h-full no-underline" href={`/recipes/${item.entry.id}`}>{item.entry.data.featured_image ? <Image class="h-52 w-full object-cover" image={item.entry.data.featured_image as never} widths={[640]} sizes="(max-width: 44rem) 100vw, 33vw" /> : <div class="grid h-52 place-items-center bg-linear-to-br from-amber-200 to-amber-500 font-black tracking-widest text-white">Recipe</div>}<div class="p-5"><small class="font-extrabold tracking-widest text-recipe-orange uppercase">Recipe</small><h3 class="my-1 text-xl font-black tracking-[-.04em]">{item.entry.data.title}</h3>{item.entry.data.summary && <p class="m-0 leading-relaxed text-recipe-muted">{item.entry.data.summary}</p>}</div></a></li> : <li class="overflow-hidden rounded-2xl bg-white shadow-[0_4px_18px_rgb(26_22_15_/_0.05)]"><a class="block h-full no-underline" href={`/recipe-library/${item.entry.id}/pdf`}><div class="grid h-52 place-items-center bg-linear-to-br from-amber-200 to-amber-500 font-black tracking-widest text-white">PDF</div><div class="p-5"><small class="font-extrabold tracking-widest text-recipe-orange uppercase">Recipe PDF</small><h3 class="my-1 text-xl font-black tracking-[-.04em]">{item.entry.data.title}</h3><p class="m-0 leading-relaxed text-recipe-muted">Open the original recipe PDF.</p></div></a></li>)}</ul> : <div class="py-16 text-center"><h3 class="text-xl font-black">No recipes match those filters.</h3><a href="/">Clear filters</a></div>}
			{totalPages > 1 && <nav class="flex justify-center gap-1" aria-label="Recipe pages"><a class="rounded-lg border border-recipe-line px-3 py-2 no-underline aria-disabled:pointer-events-none aria-disabled:opacity-40" href={pageUrl(Math.max(1, page - 1))} aria-disabled={page === 1}>Previous</a>{Array.from({ length: totalPages }, (_, i) => i + 1).map((number) => <a class:list={["min-w-10 rounded-lg border border-recipe-line px-3 py-2 text-center no-underline", { "border-recipe-ink bg-recipe-ink text-white": number === page }]} aria-current={number === page ? "page" : undefined} href={pageUrl(number)}>{number}</a>)}<a class="rounded-lg border border-recipe-line px-3 py-2 no-underline aria-disabled:pointer-events-none aria-disabled:opacity-40" href={pageUrl(Math.min(totalPages, page + 1))} aria-disabled={page === totalPages}>Next</a></nav>}
		</section>
	</div>
</Base>
