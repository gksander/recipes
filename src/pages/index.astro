---
import {
  getEmDashCollection,
  getSiteSettingsWithCacheHint,
  getTaxonomyTermsWithCacheHint,
  getTermsForEntries,
} from "emdash";
import RecipeBrowser, { type RecipeListItem } from "../components/RecipeBrowser";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const [
  { entries: recipes, cacheHint: recipesCacheHint },
  { data: mealTypes, cacheHint: mealTypesCacheHint },
  { data: dietaryTerms, cacheHint: dietaryTermsCacheHint },
  { data: ingredientTerms, cacheHint: ingredientTermsCacheHint },
  { data: settings, cacheHint: settingsCacheHint },
] = await Promise.all([
  getEmDashCollection("recipes", {
    status: "published",
    limit: 2500,
    orderBy: { published_at: "desc" },
  }),
  getTaxonomyTermsWithCacheHint("meal_type"),
  getTaxonomyTermsWithCacheHint("dietary"),
  getTaxonomyTermsWithCacheHint("ingredient"),
  getSiteSettingsWithCacheHint(),
]);
const recipeIds = recipes.map((recipe) => String(recipe.data.id));
const [dietaryByRecipe, mealsByRecipe, ingredientsByRecipe] = await Promise.all(
  [
    getTermsForEntries("recipes", recipeIds, "dietary"),
    getTermsForEntries("recipes", recipeIds, "meal_type"),
    getTermsForEntries("recipes", recipeIds, "ingredient"),
  ],
);
const recipeItems: RecipeListItem[] = [...recipes]
  .sort((a, b) => {
    const aHelloFresh = a.data.source_type === "hellofresh" ? 1 : 0;
    const bHelloFresh = b.data.source_type === "hellofresh" ? 1 : 0;
    return aHelloFresh - bHelloFresh;
  })
  .map((entry) => ({
    slug: entry.id,
    title: String(entry.data.title),
    summary: entry.data.summary ? String(entry.data.summary) : null,
    image: entry.data.featured_image
      ? {
          id: String((entry.data.featured_image as any).id),
          src: (entry.data.featured_image as any).src ?? null,
          storageKey: (entry.data.featured_image as any).meta?.storageKey ?? null,
          alt: (entry.data.featured_image as any).alt ?? "",
        }
      : null,
    mealTypes: mealsByRecipe.get(entry.data.id)?.map((term) => term.slug) ?? [],
    mealTypeLabels:
      mealsByRecipe
        .get(entry.data.id)
        ?.map((term) => ({ slug: term.slug, label: term.label })) ?? [],
    dietary: dietaryByRecipe.get(entry.data.id)?.map((term) => term.slug) ?? [],
    dietaryLabels:
      dietaryByRecipe
        .get(entry.data.id)
        ?.map((term) => ({ slug: term.slug, label: term.label })) ?? [],
    sourceType: String(entry.data.source_type ?? "original"),
    sourceFilename: entry.data.source_filename ? String(entry.data.source_filename) : null,
    ingredients:
      ingredientsByRecipe.get(entry.data.id)?.map((term) => term.slug) ?? [],
  }));
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);

if (Astro.cache.enabled) {
  Astro.cache.set(recipesCacheHint);
  Astro.cache.set(mealTypesCacheHint);
  Astro.cache.set(dietaryTermsCacheHint);
  Astro.cache.set(ingredientTermsCacheHint);
  Astro.cache.set(settingsCacheHint);
  Astro.cache.set({ maxAge: 86_400, swr: 604_800 });
}
---

<Base title={siteTitle} description={siteTagline}>
  <div class="pb-20">
    <section class="my-2 mb-12 flex min-h-80 items-center overflow-hidden rounded-3xl bg-[url('/images/recipe-hero-salmon.png')] bg-cover bg-center md:mb-20">
      <div class="max-w-xl bg-linear-to-r from-white via-background/75 to-transparent p-8 sm:p-14">
        <h1 class="my-3 text-5xl leading-[.93] font-black tracking-[-.07em] sm:text-7xl">
          Cook shit
          <br />
          <em class="not-italic text-primary">you’ll love.</em>
        </h1>
        <p class="text-lg text-muted-foreground">
          Recipes collected, crafted, and curated.
        </p>
      </div>
    </section>
    <section>
      <div>
        <span class="font-extrabold tracking-widest text-primary uppercase">
          Recipe finder
        </span>
        <h2 class="my-2 text-3xl font-black tracking-[-.05em] sm:text-5xl">
          What are you in the mood for?
        </h2>
      </div>
      <div class="mt-8">
        <RecipeBrowser
          client:load
          recipes={recipeItems}
          mealTypes={mealTypes}
          dietaryTerms={dietaryTerms}
          ingredientTerms={ingredientTerms}
        />
      </div>
    </section>
  </div>
</Base>
